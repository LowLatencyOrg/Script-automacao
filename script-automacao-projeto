#!/bin/bash

# Interrompe a execução caso ocorra algum erro inesperado em comandos críticos
set -e

sudo apt update && sudo apt upgrade -y #Atualizando pacotes do sistema 

sudo apt install -y docker.io #Instalando o Docker

docker --version #Verificando versão do Docker

sudo systemctl start docker #Iniciando Serviço do Docker

sudo systemctl enable docker #Habilitando o Docker 

sudo docker pull python:3.10-slim #Criando a imagem do Python 

sudo docker pull openjdk:17-jdk-slim #Criando a imagem do Java

sudo docker pull mysql:8.0 #Criando a imagem do Banco de Dados 

sudo docker images #Verificando a criação das imagens 

IMG_PY=$(sudo docker image ls -q --filter "reference=python:3.10-slim")
IMG_JV=$(sudo docker image ls -q --filter "reference=openjdk:17-jdk-slim")
IMG_DB=$(sudo docker image ls -q --filter "reference=mysql:8.0")

if [ -n "$IMG_PY" ] && [ -n "$IMG_JV" ] && [ -n "$IMG_DB" ]; then
    echo "[SUCESSO] - Todas as imagens foram instaladas corretamente!"
else
    echo "[ERRO] - Uma ou mais imagens base falharam ao ser baixadas."
    exit 1
fi

sudo docker run --rm python:3.10-slim python3 --version # Criando container Python

sudo docker run --rm openjdk:17-jdk-slim java -version # Criando container Java

if [ $? -eq 0 ]; then
    echo "[SUCESSO] - Containers base de Python e Java rodaram perfeitamente!"
else
    echo "[ERRO]  - Falha ao rodar os containers base."
    exit 1
fi

REPO_URL="https://github.com/LowLatencyOrg/Site-Grupo10.git" # Clonando o projeto do grupo 
PASTA_PROJETO="Site-Grupo10"

if [ -d "$PASTA_PROJETO" ]; then
    echo "O repositório já foi clonado"
    cd $PASTA_PROJETO
    git pull
    npm start
else
    git clone $REPO_URL
    cd $PASTA_PROJETO
    npm i
    npm start
fi

if [ -f "Dockerfile" ]; then # Criando a imagem Docker do Projeto
    sudo docker build -t img-site-grupo10:latest .
else
    echo "[ERRO] Dockerfile não encontrado na raiz do repositório!"
    exit 1
fi

IMG_SITE=$(sudo docker image ls -q --filter "reference=img-site-grupo10:latest")

if [ -n "$IMG_SITE" ]; then #Conferindo se a imagem Docker foi criada 
    echo "[SUCESSO]- Imagem 'img-site-grupo10:latest' criada com sucesso!"
else
    echo "[ERRO] - A imagem da API/Site do grupo não foi criada."
    exit 1
fi

#Criando e Conectando os Containers do site e do banco
sudo docker network create rede-grupo10 

# Limpa execuções anteriores se existirem
sudo docker stop container-banco-grupo10 container-site-grupo10 
sudo docker rm container-banco-grupo10 container-site-grupo10 

# Subindo o container do Banco de Dados
sudo docker run -d \
  --name container-banco-grupo10 \
  --network rede-grupo10 \
  -e MYSQL_ROOT_PASSWORD=rootpass \
  -e MYSQL_DATABASE=db_grupo10 \
  mysql:8.0

# Subindo o container do Site/API
sudo docker run -d \
  --name container-site-grupo10 \
  --network rede-grupo10 \
  -p 8080:80 \
  img-site-grupo10:latest || \
sudo docker run -d \
  --name container-site-grupo10 \
  --network rede-grupo10 \
  -p 8080:8080 \
  img-site-grupo10:latest

#Conferindo se tudo foi criado corretamente


STATUS_BANCO=$(sudo docker ps -q --filter "name=container-banco-grupo10" --filter "status=running")
STATUS_SITE=$(sudo docker ps -q --filter "name=container-site-grupo10" --filter "status=running")

if [ -n "$STATUS_BANCO" ] && [ -n "$STATUS_SITE" ]; then
    echo "Banco e Site Rodando Corretamente!"
    sudo docker ps
else
    echo "ERRO"
    exit 1
fi
